  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Happy Level Up!</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap');
    :root{--ink:#1b1c40;--blue:#2068da;--yellow:#ffd64d;--pink:#ff5b9c;--paper:#fff6df;--green:#38c878}*{box-sizing:border-box}body{margin:0;overflow:hidden;background:#8bd7ff;color:var(--ink);font-family:'Press Start 2P',monospace}.screen{display:none;min-height:100vh;padding:84px clamp(18px,6vw,92px) 94px;position:relative;overflow:auto;background:linear-gradient(#73c9ff 0 62%,#b5edff 62%)}.screen.active{display:block}.screen:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.16;background:repeating-linear-gradient(90deg,#fff 0 2px,transparent 2px 5px)}h1,h2,p{position:relative}.pixel-title{font-size:clamp(25px,4vw,53px);line-height:1.45;text-shadow:5px 5px 0 #fff,9px 9px 0 var(--ink);margin:0 0 25px;color:var(--pink)}.subtitle{font:clamp(20px,3vw,30px) VT323,monospace;letter-spacing:1px;max-width:740px}.ground{position:absolute;bottom:0;left:0;width:100%;height:82px;background:repeating-linear-gradient(90deg,#579a37 0 25px,#75be44 25px 50px);border-top:8px solid #315d2a}.cloud{position:absolute;background:#fff;border:6px solid var(--ink);width:105px;height:35px;box-shadow:25px -20px #fff,25px -26px var(--ink),60px -7px #fff,60px -13px var(--ink)}.cloud.c1{top:100px;left:8%}.cloud.c2{top:160px;right:8%;transform:scale(.7)}.topbar{z-index:10;position:fixed;top:15px;left:18px;right:18px;display:flex;justify-content:space-between;align-items:center;pointer-events:none}.level{background:#fff;padding:12px;border:4px solid var(--ink);font-size:10px;pointer-events:auto}.music{display:flex;gap:10px;align-items:center;pointer-events:auto}.disc{width:45px;height:45px;border-radius:50%;border:5px solid #fff;background:radial-gradient(circle,#ffd64d 0 4px,#ff5b9c 5px 10px,#1a1841 11px);box-shadow:3px 3px 0 var(--ink);animation:spin 3s linear infinite;animation-play-state:paused}.disc.on{animation-play-state:running}.btn{border:4px solid var(--ink);background:var(--yellow);color:var(--ink);padding:13px 14px;font:11px 'Press Start 2P';box-shadow:5px 5px 0 var(--ink);cursor:pointer;transition:.12s}.btn:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 var(--ink)}.btn:disabled{filter:grayscale(1);cursor:not-allowed}.nav{position:fixed;z-index:10;bottom:18px;left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:center}.nav button{border:3px solid var(--ink);background:#fff;padding:10px;font:10px 'Press Start 2P';cursor:pointer}.dots{display:flex;gap:5px}.dot{width:10px;height:10px;background:#fff;border:2px solid var(--ink)}.dot.active{background:var(--pink)}.hero{max-width:780px;padding-top:10vh}.spidey{position:absolute;right:12%;bottom:75px;width:145px;height:190px;background:linear-gradient(90deg,#e93743 0 32%,#1a3156 32% 68%,#e93743 68%);border:7px solid var(--ink);clip-path:polygon(35% 0,65% 0,78% 14%,72% 33%,94% 48%,78% 55%,71% 100%,29% 100%,22% 55%,6% 48%,28% 33%,22% 14%);filter:drop-shadow(9px 9px 0 #fff)}.spidey:after{content:'◉ ◉';position:absolute;top:34px;left:32px;color:#fff;font-size:28px;white-space:nowrap}.gamebox{position:relative;z-index:2;background:#fffbe9;border:6px solid var(--ink);box-shadow:12px 12px 0 rgba(27,28,64,.4);padding:clamp(18px,3vw,35px);max-width:800px;margin:28px auto;text-align:center}.stage{height:220px;background:linear-gradient(#1c3a81 0 70%,#72502c 70%);border:5px solid var(--ink);position:relative;overflow:hidden}.webline{position:absolute;left:50%;height:100%;border-left:3px dashed #fff}.runner{position:absolute;bottom:50px;left:10%;font-size:65px;transition:left .25s}.coin{position:absolute;bottom:70px;left:67%;font-size:37px}.tap{margin-top:20px}.answer{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:25px 0}.answer input{font:22px VT323;padding:10px;border:4px solid var(--ink);min-width:250px}.feedback{min-height:30px;font:24px VT323;color:#d22}.question{font-size:clamp(16px,2.3vw,24px);line-height:1.8}.sequence{display:flex;justify-content:center;gap:15px;margin:25px}.arrow{width:64px;height:64px;border:4px solid var(--ink);font-size:28px;background:#fff;cursor:pointer}.arrow.flash{background:var(--yellow);transform:scale(1.13)}.card{background:var(--paper);border:6px solid var(--ink);box-shadow:12px 12px 0 var(--ink);max-width:760px;margin:5vh auto;padding:clamp(24px,6vw,62px);text-align:center;position:relative}.card:before{content:'✦  ✦  ✦';position:absolute;top:14px;left:20px;right:20px;color:var(--pink)}.letter-wrap{text-align:center}.envelope{width:min(500px,85vw);height:280px;margin:32px auto;background:#ff92b9;border:6px solid var(--ink);position:relative;cursor:pointer;box-shadow:11px 11px 0 var(--ink)}.envelope:after{content:'♥';position:absolute;left:42%;top:65px;font-size:55px;color:#fff}.letter{display:none;max-width:650px;margin:20px auto;background:#fffbed;border:5px solid var(--ink);padding:35px;font:27px VT323;text-align:left;line-height:1.25}.letter.show{display:block}.album{max-width:900px;margin:30px auto;background:#6e3f36;border:12px solid #3e2522;box-shadow:13px 13px 0 var(--ink);padding:18px}.book{display:grid;grid-template-columns:1fr 1fr;min-height:420px;background:var(--paper);border:5px solid #2f1d1b}.cover{grid-column:1/-1;display:grid;place-items:center;text-align:center;cursor:pointer;background:linear-gradient(135deg,#fa6eab,#fece5a)}.cover h2{font-size:clamp(28px,5vw,55px);line-height:1.5}.album-page{display:none;padding:25px;gap:18px;align-items:center}.album-page.open{display:flex}.photo{width:52%;aspect-ratio:1;background:linear-gradient(135deg,#ffdd8a,#fa6eab 50%,#7dc8ff);border:10px solid #fff;outline:4px solid var(--ink);display:grid;place-items:center;font-size:62px;transform:rotate(-3deg)}.note{font:25px VT323;line-height:1.15}.album-controls{margin-top:12px;display:flex;justify-content:space-between}.surprise-grid{max-width:850px;margin:30px auto;display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.gift{aspect-ratio:1;background:var(--yellow);border:5px solid var(--ink);box-shadow:6px 6px 0 var(--ink);display:grid;place-items:center;font-size:clamp(30px,6vw,70px);cursor:pointer}.gift.open{background:var(--pink);font-size:18px;text-align:center;padding:8px}.invite{background:linear-gradient(135deg,#24135d,#543a9e);color:#fff}.invite .card{background:#fff4cf}.rsvp{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:600px){.spidey{opacity:.35;right:-20px}.screen{padding-inline:22px}.topbar{top:10px;left:10px;right:10px}.level{font-size:8px}.btn{font-size:9px;padding:10px}.book{min-height:370px}.album-page.open{flex-direction:column}.photo{width:75%}.nav button{padding:8px;font-size:8px}}
  </style>
</head>
<body>
  <div class="topbar"><div class="level" id="level">LEVEL 01 / 09</div><div class="music"><div class="disc" id="disc"></div><button class="btn" id="musicBtn">♫ PLAY MUSIC</button></div></div>
  <main>
    <section class="screen active" data-title="Spider Start"><div class="cloud c1"></div><div class="cloud c2"></div><div class="hero"><h1 class="pixel-title">HELLO,<br>ELYN!</h1><p class="subtitle">Tekan musik di kanan atas dahulu untuk membuka misi Spidey. Setelah musik menyala, raih koinnya!</p><div class="gamebox"><div class="stage"><div class="webline"></div><div class="runner" id="runner">🕷️</div><div class="coin">🪙</div></div><button class="btn tap" id="runBtn" disabled>AYO LOMPAT!</button><p class="feedback" id="runMsg">Musik adalah kekuatan supermu!</p></div></div><div class="spidey"></div><div class="ground"></div></section>
    <section class="screen" data-title="Tebak Tebakan"><h1 class="pixel-title">RIDDLE QUEST</h1><div class="gamebox"><p class="question" id="question">01. Kopi kesukaan ku apa coba?</p><div class="answer"><input id="answer" placeholder="jawab di sini..." autocomplete="off"><button class="btn" id="answerBtn">JAWAB</button></div><p class="feedback" id="quizMsg"></p><p class="subtitle">Kalahkan 2 pertanyaan untuk membuka level berikutnya.</p></div><div class="spidey"></div><div class="ground"></div></section>
    <section class="screen" data-title="Web Reflex"><h1 class="pixel-title">WEB REFLEX!</h1><p class="subtitle">Ikuti urutan panah yang berkedip. Selesaikan dan baru bisa lanjut!</p><div class="gamebox"><div class="sequence" id="seq"><button class="arrow" data-v="↑">↑</button><button class="arrow" data-v="→">→</button><button class="arrow" data-v="↓">↓</button><button class="arrow" data-v="←">←</button></div><button class="btn" id="startReflex">MULAI MISI</button><p class="feedback" id="reflexMsg"></p></div><div class="spidey"></div><div class="ground"></div></section>
    <section class="screen" data-title="Birthday"><div class="card"><h1 class="pixel-title">HAPPY<br>BIRTHDAY! 🎂</h1><p class="subtitle">Selamat bertambah satu level yaa saayangg! Semoga kamu sehat selalu Yaaa sayangg!!, semoga semakinn diberi kesabaran dann diberiii rezeky yang lancaar.. Semoga Kamu ga berubah yaa prasaan nya ke aku.. semoga sayang terus yaa?? aku sayang km bb..</p><p class="subtitle">Sekali lagiiiii.. selamat ulangtahun babeeee!!!!✦</p></div><div class="ground"></div></section>
    <section class="screen" data-title="Surat Rahasia"><h1 class="pixel-title">SPECIAL MAIL</h1><div class="letter-wrap"><div class="envelope" id="envelope"></div><p class="subtitle">Klik amplop untuk membuka pesan rahasia!</p><article class="letter" id="letter">Haiiii sayanggg!!<br><br>Selamat ulang tahun yang ke 16 yaaaa!!!, bener bener hari yang aku tunggu bgttt sampe aku bikin website ini h-satu bulannn hhahaa. Sayaangg makasih yaaa selama ini, aku bener bener bisa ngerasain hal yang gapernah aku rasain dari sebelumnya, aku sayang bgt samakamu, bener bener bersyukur banget punya km<br><br>DHmmm dann yap dari sekian lama aku tunggu selama setengah tahunnn, akhirnyaa aku bisa kesampaiannn yaaa ngucapin kamu ultah, xixiixxix.. Sekaliii lagii selamat ulang tahun yaaa sayangg.. Semogaaa panjang umurnyaaa, dan semogaaa bisa menjadi pribadi yang jauhhh lebih baik lagi dari sebelumnyaaa... Semogaa sayang aku terussss... ♥</article></div><div class="ground"></div></section>
    <section class="screen" data-title="Album"><h1 class="pixel-title">Memory Book</h1><div class="album"><div class="book" id="book"><div class="cover" id="cover"><h2>OUR<br>MEMORY<br><small>click to open</small></h2></div><div class="album-page" data-page="0"><div class="photo">🌟</div><div class="note">Page 1b<br><br>Awal dari cerita-cerita kecil yang selalu seru.</div></div><div class="album-page" data-page="1"><div class="photo">☕</div><div class="note">Halaman 2<br><br>Segelas kopi dan obrolan yang tidak pernah kehabisan topik.</div></div><div class="album-page" data-page="2"><div class="photo">🎮</div><div class="note">Halaman 3<br><br>Ketawa sampai lupa waktu: momen favorit.</div></div><div class="album-page" data-page="3"><div class="photo">🌈</div><div class="note">Halaman 4<br><br>Langit yang bagus, hari yang baik, dan kamu.</div></div><div class="album-page" data-page="4"><div class="photo">🎂</div><div class="note">Halaman 5<br><br>Untuk semua kenangan berikutnya yang belum kita buat!</div></div></div><div class="album-controls"><button class="btn" id="prevPage">←</button><button class="btn" id="nextPage">→</button></div></div><div class="ground"></div></section>
    <section class="screen" data-title="Loot Box"><h1 class="pixel-title">BIRTHDAY LOOT!</h1><p class="subtitle">Pilih kotak hadiahmu. Setiap hadiah punya buff spesial untuk tahun baru ini!</p><div class="surprise-grid" id="gifts"><div class="gift">🎁</div><div class="gift">🎁</div><div class="gift">🎁</div></div><div class="ground"></div></section>
    <section class="screen" data-title="Pixel Fortune"><h1 class="pixel-title">FORTUNE ARCADE</h1><div class="gamebox"><p class="subtitle">Tekan tombol dan biarkan mesin arcade memilih mantra ulang tahunmu.</p><p id="fortune" class="question">☆ siap untuk keberuntungan? ☆</p><button class="btn" id="fortuneBtn">PUTAR MESIN!</button></div><div class="spidey"></div><div class="ground"></div></section>
    <section class="screen invite" data-title="Undangan"><div class="card"><h1 class="pixel-title">YOU'RE INVITED!</h1><p class="subtitle">Mari rayakan satu level kehidupan yang baru!</p><p class="question">BIRTHDAY PARTY<br><br>📅 Tanggal: isi tanggalmu<br>🕒 Jam: isi jamnya<br>📍 Lokasi: isi lokasinya</p><p class="subtitle">Datang ya, karena pesta akan kurang lengkap tanpa kamu!</p><div class="rsvp"><button class="btn" onclick="alert('Yay! RSVP kamu diterima!')">AKU DATANG!</button></div></div><div class="ground"></div></section>
  </main>
  <nav class="nav"><button id="prev">← PREV</button><div class="dots" id="dots"></div><button id="next">NEXT →</button></nav>
  <script>
    const screens=[...document.querySelectorAll('.screen')], dots=document.querySelector('#dots'), level=document.querySelector('#level');let current=0,musicOn=false,quiz=0,runDone=false,reflexDone=false;
    screens.forEach((_,i)=>{const d=document.createElement('i');d.className='dot';dots.append(d)});const go=i=>{if(i<0||i>=9)return;if(current===1&&quiz<2)return;if(current===0&&!runDone)return;current=i;screens.forEach((s,n)=>s.classList.toggle('active',n===i));[...dots.children].forEach((d,n)=>d.classList.toggle('active',n===i));level.textContent=`LEVEL ${String(i+1).padStart(2,'0')} / 09`;document.querySelector('#prev').style.visibility=i?'visible':'hidden';document.querySelector('#next').style.visibility=i===8?'hidden':'visible';window.scrollTo(0,0)};go(0);document.querySelector('#prev').onclick=()=>go(current-1);document.querySelector('#next').onclick=()=>go(current+1);
    let ac;function music(){if(musicOn)return;ac=new (window.AudioContext||window.webkitAudioContext)();const notes=[261.6,329.6,392,523.2,392,329.6];let n=0;setInterval(()=>{if(!musicOn)return;const o=ac.createOscillator(),g=ac.createGain();o.frequency.value=notes[n++%notes.length];o.type='square';g.gain.setValueAtTime(.035,ac.currentTime);g.gain.exponentialRampToValueAtTime(.001,ac.currentTime+.18);o.connect(g).connect(ac.destination);o.start();o.stop(ac.currentTime+.2)},220);musicOn=true;document.querySelector('#disc').classList.add('on');document.querySelector('#musicBtn').textContent='♫ MUSIC ON';document.querySelector('#runBtn').disabled=false;document.querySelector('#runMsg').textContent='Musik aktif! Sekarang lompat untuk mengambil koin.'}document.querySelector('#musicBtn').onclick=music;
    document.querySelector('#runBtn').onclick=()=>{if(!musicOn)return;const r=document.querySelector('#runner');r.style.left='62%';r.style.bottom='115px';setTimeout(()=>{r.style.bottom='50px';runDone=true;document.querySelector('#runMsg').textContent='KOIN DIDAPAT! Level 2 terbuka →';},500)};
    const qs=['Kopi kesukaan ku apa?','Baju apa yang aku pake harii ini???'],keys=['americano','hitam'];function check(){let a=document.querySelector('#answer').value.trim().toLowerCase();if(a===keys[quiz]){quiz++;document.querySelector('#answer').value='';if(quiz===2){document.querySelector('#quizMsg').textContent='BENAR SEMUA! Level berikutnya terbuka!';document.querySelector('#question').textContent='MISI SELESAI! Kamu hebat.'}else{document.querySelector('#question').textContent='02. '+qs[1];document.querySelector('#quizMsg').textContent='Benar! Lanjut pertanyaan terakhir.'}}else document.querySelector('#quizMsg').textContent='Belum tepat, coba lagi ya!'}document.querySelector('#answerBtn').onclick=check;document.querySelector('#answer').onkeydown=e=>e.key==='Enter'&&check();
    const pattern=['↑','→','↓','←'], arrows=[...document.querySelectorAll('.arrow')];let playing=false,input=[];document.querySelector('#startReflex').onclick=async()=>{if(playing||reflexDone)return;playing=true;input=[];document.querySelector('#reflexMsg').textContent='Perhatikan...';for(const v of pattern){let b=arrows.find(x=>x.dataset.v===v);b.classList.add('flash');await new Promise(r=>setTimeout(r,550));b.classList.remove('flash');await new Promise(r=>setTimeout(r,170))}document.querySelector('#reflexMsg').textContent='Sekarang ulangi urutannya!';playing=false};arrows.forEach(b=>b.onclick=()=>{if(playing||reflexDone)return;input.push(b.dataset.v);if(b.dataset.v!==pattern[input.length-1]){input=[];document.querySelector('#reflexMsg').textContent='Ups, urutannya salah. Coba lagi!';return}if(input.length===pattern.length){reflexDone=true;document.querySelector('#reflexMsg').textContent='SUKSES! Membuka kejutan...';setTimeout(()=>go(3),900)}});
    document.querySelector('#envelope').onclick=()=>{document.querySelector('#letter').classList.add('show');document.querySelector('#envelope').style.display='none'};let page=0;const pages=[...document.querySelectorAll('.album-page')];function showPage(){pages.forEach((x,i)=>x.classList.toggle('open',i===page))}document.querySelector('#cover').onclick=()=>{document.querySelector('#cover').style.display='none';showPage()};document.querySelector('#prevPage').onclick=()=>{page=(page+4)%5;showPage()};document.querySelector('#nextPage').onclick=()=>{page=(page+1)%5;showPage()};const buffs=['+100% ketawa sepanjang tahun','Shield anti bad mood aktif!','Kebahagiaan legendary ditemukan!'];[...document.querySelectorAll('.gift')].forEach((g,i)=>g.onclick=()=>{g.classList.add('open');g.textContent=buffs[i]});document.querySelector('#fortuneBtn').onclick=()=>{const f=['Hari ini kamu jadi tokoh utama!','Semoga rezeki dan bahagia respawn terus!','Quest baru: wujudkan satu impianmu!','Critical hit: kamu dicintai banyak orang!'];document.querySelector('#fortune').textContent=f[Math.floor(Math.random()*f.length)]};
  </script>
